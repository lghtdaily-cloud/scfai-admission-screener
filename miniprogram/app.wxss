/* app.wxss — 全局设计系统（简约版）
   设计原则：大留白 · 弱阴影 · 细边框 · 单一主色 · 层级靠字号与灰阶区分 */

page {
  /* —— 色板 —— */
  --primary: #6d5efc;
  --primary-soft: #f2f0ff;
  --success: #16a34a;
  --success-soft: #e8f7ee;
  --warning: #d97706;
  --warning-soft: #fdf3e3;
  --danger: #dc2626;
  --danger-soft: #fdecec;
  --text: #1c1f26;
  --text-2: #4b5563;
  --muted: #9aa1ad;
  --line: #eef0f3;
  --bg: #f6f7f9;
  --card: #ffffff;
  --radius: 20rpx;
  --radius-sm: 14rpx;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}

/* —— 布局 —— */
.container {
  padding: 20rpx 20rpx 40rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 1rpx 2rpx rgba(16, 24, 40, .03);
}

/* —— 文字层级 —— */
.title {
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: .3rpx;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 25rpx;
  color: var(--muted);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.muted { color: var(--muted); }
.divider { height: 1rpx; background: var(--line); margin: 20rpx 0; }

/* —— 按钮 —— */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 16rpx;
  font-size: 29rpx;
  font-weight: 600;
  border: none;
  letter-spacing: .5rpx;
}
.btn::after { border: none; }
.btn-primary { background: var(--primary); color: #fff; }
.btn-ghost { background: var(--primary-soft); color: var(--primary); }
.btn-line { background: #fff; color: var(--primary); border: 1rpx solid var(--primary); }
.btn-block { width: 100%; margin-top: 16rpx; }
.btn[disabled] { opacity: .5; }

.mini-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  margin-left: 12rpx;
}
.mini-btn::after { border: none; }
.mini-btn.danger { background: var(--danger-soft); color: var(--danger); }

/* —— 标签 —— */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.5;
  background: var(--primary-soft);
  color: var(--primary);
}
.tag-success { background: var(--success-soft); color: var(--success); }
.tag-warning { background: var(--warning-soft); color: var(--warning); }
.tag-danger { background: var(--danger-soft); color: var(--danger); }
.tag-muted { background: #f3f5f7; color: var(--muted); }

/* —— 列表 / 键值 —— */
.kv {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 27rpx;
}
.kv .muted { flex: none; width: 168rpx; color: var(--muted); font-size: 26rpx; }

.txt { font-size: 27rpx; color: var(--text-2); line-height: 1.75; }

/* —— 选项（药丸多选） —— */
.opts { display: flex; flex-wrap: wrap; }
.opt {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #f4f5f7;
  color: var(--text-2);
  font-size: 25rpx;
  margin: 0 14rpx 14rpx 0;
  border: 1rpx solid transparent;
}
.opt-on {
  background: var(--primary-soft);
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 500;
}

/* —— 表单 —— */
.field { margin-bottom: 24rpx; }
.field-label { font-size: 27rpx; font-weight: 500; margin-bottom: 12rpx; color: var(--text); }
.field-input,
.field-textarea {
  width: 100%;
  background: #fafbfc;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}
.field-input:focus, .field-textarea:focus { border-color: var(--primary); background: #fff; }
.field-textarea { height: 168rpx; }

/* —— 文件行 —— */
.file, .file-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.file:last-child, .file-row:last-child { border-bottom: none; }
.file-l, .file-label { font-size: 27rpx; }
.file-name { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
.file-s { font-size: 24rpx; color: var(--muted); }
.file-s.ok { color: var(--success); }
.file-s.no { color: var(--danger); }
.file-open { font-size: 25rpx; color: var(--primary); padding-left: 20rpx; }
.file-info { flex: 1; min-width: 0; }
.file-btns { display: flex; align-items: center; flex: none; }

/* —— 统计 —— */
.stats { display: flex; }
.stats .stat, .stats > view { flex: 1; text-align: center; }
.stat-n, .n { font-size: 40rpx; font-weight: 700; line-height: 1.2; }
.stat-l, .l { font-size: 22rpx; color: var(--muted); margin-top: 4rpx; }

/* —— 空态 —— */
.empty {
  text-align: center;
  color: var(--muted);
  font-size: 25rpx;
  padding: 48rpx 0;
}

/* —— 行 —— */
.row { display: flex; align-items: center; justify-content: space-between; }

/* —— 语义色 / 弹性 —— */
.c-primary { color: var(--primary); }
.c-ok { color: var(--success); }
.c-warn { color: var(--warning); }
.c-err { color: var(--danger); }
.btn-flex { flex: 1; }
.can-name { font-weight: 600; font-size: 30rpx; }
